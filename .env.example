# Atlas hackathon sandbox cluster (create it through the link in the sandbox email)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=goalkeeper
# the MCP server reads the same string
MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goalkeeper

# OpenRouter. Cheap open-weight models only (DeepSeek, Qwen), never Claude.
OPENROUTER_API_KEY=
WORKER_MODEL=deepseek/deepseek-v4-flash
# Reasoning effort for the worker model: none (default), low, medium, high.
# none keeps the single-shot baseline near 13% so the curve has room.
WORKER_REASONING=none

# Cheap model for enrichment, classification and briefing synthesis (also OpenRouter)
ENRICH_MODEL=deepseek/deepseek-v4-flash

# Voyage AI: 200M free tokens for the event, key from dashboard.voyageai.com
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5

# Runtime
WORKERS_TARGET=8
BUDGET_USD=200

# Iteration deadline in ms (default 6 minutes); hard puzzles need 10.
DEADLINE_MS=600000
