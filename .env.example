# Atlas hackathon sandbox cluster (create it through the link in the sandbox email)
MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goalkeeper
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goalkeeper
# OpenRouter: code arrives by email from 10:30 on Saturday
OPENROUTER_API_KEY=
# Voyage AI: 200M free tokens for the event, key from dashboard.voyageai.com
VOYAGE_API_KEY=
# Optional: Anthropic key if workers should not run through the Claude Code subscription
ANTHROPIC_API_KEY=
