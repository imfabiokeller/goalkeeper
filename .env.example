# Atlas hackathon sandbox cluster (create it through the link in the sandbox email)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=goalkeeper
# the MCP server reads the same string
MDB_MCP_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/goalkeeper

# OpenRouter: code arrives by email from 10:30 on Saturday. Workers.
OPENROUTER_API_KEY=
WORKER_MODEL=anthropic/claude-sonnet-5

# Cerebras: enrichment and crowd classification
CEREBRAS_API_KEY=
ENRICH_MODEL=llama-3.3-70b

# Voyage AI: 200M free tokens for the event, key from dashboard.voyageai.com
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5

# Runtime
WORKERS_TARGET=8
BUDGET_USD=200
