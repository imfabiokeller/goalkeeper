{
  "name": "goalkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "indexes": "node --env-file=.env src/shared/indexes.ts",
    "seed": "node --env-file=.env src/seed/index.ts",
    "worker": "node --env-file=.env src/worker/index.ts",
    "invariants": "node --env-file=.env src/planner/invariants.ts",
    "baseline": "node --env-file=.env usecase/tools/baseline.ts",
    "screen": "next dev src/screen -p 3000",
    "screen:build": "next build src/screen",
    "screen:start": "next start src/screen -p 3000",
    "screen:typecheck": "tsc -p src/screen/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.116",
    "mongodb": "^7.6.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "voyage-ai-provider": "^5.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
